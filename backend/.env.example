# Copy to .env and fill in. Never commit the filled-in file.
SUPABASE_URL=
DATABASE_URL=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=

# Optional: override the extraction model (default gemini-3.1-flash-lite)
GEMINI_MODEL=

# Comma-separated browser origins allowed to call this API.
# Defaults to localhost:5173 and :5174 when unset.
CORS_ORIGINS=
