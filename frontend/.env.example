# Copy to .env and fill in. Never commit the filled-in file.

# Where the FastAPI backend is listening.
VITE_API_URL=http://localhost:8000

# Supabase project URL, the same one the backend uses.
VITE_SUPABASE_URL=

# The PUBLISHABLE key (sb_publishable_... or the legacy anon JWT).
# Never put the secret/service key here: anything with VITE_ is bundled into
# the JavaScript every visitor downloads, and the secret key bypasses RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in. Off unless set to true, because the provider must first be
# enabled in the Supabase dashboard (Authentication -> Providers -> Google).
# While it is off, the login and signup pages show only the email form.
VITE_ENABLE_GOOGLE_AUTH=false
